# Build output:
lib/
dist/
/serverConfig.json
# A deployment's settings for an app build (team, link host) and the xcconfig
# made from them; never committed.
/clientConfig.json
/clientConfig.xcconfig
/mobile/apps/*/clientConfig.json
/mobile/apps/*/clientConfig.xcconfig

# Package managers:
node_modules/
npm-debug.log
stats.json

# Editors:
.DS_Store
.idea/
.vscode/

# Chrome data:
chromeData/

# Images:
/images/

# Visual regression artifacts:
/screenshots/

# React Native, iOS
ios/Pods/
# Derived data from the device build in src/MOBILE.md.
ios/build-device/
ios/build/
ios/.xcode.env.local
ios/*.xcworkspace
ios/Podfile.lock.bak
*.xcuserdatad/
DerivedData/

# React Native, Android
android/.gradle/
android/.kotlin/
android/app/build/
android/build/
android/local.properties
*.keystore
!android/app/debug.keystore

# Metro
.metro-cache/
android/app/.cxx/

# Test coverage reports:
coverage/

# Locally generated Android debug signing key
/android/app/debug.keystore

# Private deployment settings and decrypted signing material:
/deployConfig.json
/.bundle/
/vendor/bundle/
/.test-tools/
/fastlane/report.xml
/fastlane/README.md
/fastlane/Preview.html

# Local build counter snapshot
/buildNum.json

# Generated deployment staging, archives and dependency markers at any app depth:
.deploy/
.deploy-dependencies
/.deploy-export/
/.deploy-macos/
/distribution.dmg
