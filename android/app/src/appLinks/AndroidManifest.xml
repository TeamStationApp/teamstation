<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The app's own link host, from the build's clientConfig.json, which the
      build merges in only when there is one. The server mails sign-in links
      from an app to this host, and answers /.well-known/assetlinks.json there
      with this app's signing fingerprint, so `autoVerify` hands the link to
      the app rather than offering a chooser. Sign-in and TV approval links
      open in the app; other addresses remain with the web site.
    -->
    <application>
        <!--
          Shared sign-in credentials: the link host's assetlinks.json, which
          grants get_login_creds to this app and its web origin, so a password
          saved for one is offered in the other.
        -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />
        <activity android:name=".MainActivity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${appLinkHost}"
                    android:pathPrefix="/signin/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" android:path="/tv-login" />
            </intent-filter>
        </activity>
    </application>
</manifest>
