# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Expo modules without the `expo` package: `expo/scripts/autolinking.rb` is
# these two requires and the `use_expo_modules!` below, and the rest of that
# package is a runtime this app does not use. See src/MOBILE.md.
expo_autolinking = File.dirname(Pod::Executable.execute_command('node', ['-p',
  'require.resolve("expo-modules-autolinking/package.json", {paths: [process.argv[1]]})',
  __dir__]).strip)
require File.join(expo_autolinking, 'scripts/ios/autolinking_manager')
require File.join(expo_autolinking, 'scripts/ios/xcode_env_generator')

def use_expo_modules!(options = {})
  return if @current_target_definition.autolinking_manager.present?
  @current_target_definition.autolinking_manager =
    Expo::AutolinkingManager.new(self, @current_target_definition, options).use_expo_modules!
  maybe_generate_xcode_env_file!()
  generate_or_remove_xcode_env_updates_file!()
end

# ExpoModulesCore and expo-gl need iOS 16.4; React Native's own floor is 15.1.
platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TeamStation' do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Argon2Swift's Swift module imports its bundled C module. CocoaPods does
    # not propagate that module search path to Swift consumers automatically.
    argon_consumers = installer.pods_project.targets.select { |t| t.name == 'ExpoArgon2' }
    argon_consumers += installer.aggregate_targets.flat_map(&:user_targets)
    argon_consumers.each do |target|
      target.build_configurations.each do |build|
        paths = build.build_settings['SWIFT_INCLUDE_PATHS'] || '$(inherited)'
        unless paths.to_s.include?('$(PODS_ROOT)/Argon2Swift/Sources/Modules')
          build.build_settings['SWIFT_INCLUDE_PATHS'] = "#{paths} $(PODS_ROOT)/Argon2Swift/Sources/Modules"
        end
      end
    end
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
