<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  A build with no app link host still declares an age range. The target
	  defaults TS_APP_ENTITLEMENTS to this file, and clientConfig.xcconfig
	  replaces it with TeamStation.entitlements only when clientConfig.json
	  names an appOrigin. It is never empty, because Expo's configure phase
	  lists the entitlements file as an input, and an empty name makes that
	  input the ios/ directory, a dependency cycle.
	-->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<!--
	  Pushes: development APNs unless the build says otherwise (a Mason archive
	  passes production). The keychain group is the app's own default group,
	  named so the notification extension can read the session and chat keys.
	-->
	<key>aps-environment</key>
	<string>$(TS_APS_ENVIRONMENT)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(TS_APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
