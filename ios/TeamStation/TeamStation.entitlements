<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app's own link host, from the build's clientConfig.json through
	  clientConfig.xcconfig. Signed in only when the build has one: the target
	  takes this file from TS_APP_ENTITLEMENTS, and NoAppLinks.entitlements otherwise.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(TS_APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
