{
  "name": "@gamestation/director",
  "version": "1.0.0",
  "private": true,
  "description": "GS Director — iPadOS live directing app. Node scripts only; the app itself is built with xcodebuild.",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "build:sim": "bash scripts/build-sim.sh",
    "build:device": "bash scripts/build-device.sh",
    "boot:sim": "bash scripts/boot-sim.sh",
    "fixtures": "node scripts/make-fixtures.js",
    "test:unit": "bash scripts/test-unit.sh",
    "rtsp:farm": "node scripts/fakeRtspCameras.js",
    "test:ui": "node scripts/run-maestro.js",
    "verify:archives": "node scripts/verifyArchives.js",
    "profile:load": "node scripts/loadProfile.js"
  },
  "engines": {
    "node": ">=20"
  }
}
