{
  "name": "@teamstation/cameraman",
  "version": "1.0.0",
  "private": true,
  "description": "TS Cameraman — turns an iPhone into an RTSP camera source. Node scripts only; the app itself is built with xcodebuild.",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "build:sim": "bash scripts/build-sim.sh",
    "build:device": "bash scripts/build-device.sh",
    "boot:sim": "bash scripts/boot-sim.sh",
    "capabilities": "bash scripts/capabilities.sh",
    "test:unit": "bash scripts/test-unit.sh",
    "test:integration": "node scripts/rtspClient.js",
    "test:ui": "node scripts/run-maestro.js",
    "verify:encode": "bash scripts/verifyEncode.sh",
    "verify:stream": "bash scripts/verifyStream.sh",
    "verify:clients": "bash scripts/verifyClientCount.sh",
    "control": "node scripts/control.js"
  },
  "engines": {
    "node": ">=20"
  }
}
