{
  "name": "@teamstation/cameraman-android",
  "version": "1.0.0",
  "private": true,
  "description": "TS Cameraman for Android — turns a handset into an RTSP camera source that keeps streaming in the background. Node scripts only; the app itself is built with Gradle.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "device:install": "bash scripts/install.sh",
    "device:launch": "bash scripts/launch.sh",
    "test:unit": "bash scripts/test-unit.sh",
    "verify:stream": "bash scripts/verifyStream.sh",
    "verify:background": "bash scripts/verifyBackground.sh",
    "control": "bash scripts/control.sh",
    "params": "node ../tsCameraman/scripts/rtspParams.js --port 8554",
    "icons": "node ../../icons/generateAppIcons.js"
  },
  "engines": {
    "node": ">=20"
  }
}
