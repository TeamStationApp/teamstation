# Generated Xcode project (source of truth is project.yml)
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Build products
DerivedData/
build/
.build/
*.ipa
*.dSYM.zip
*.dSYM

# Test + measurement output
reports/
maestro/reports/
maestro/snippets/
maestro/config.env
# `takeScreenshot` writes beside the flow that asked for it, so every run leaves PNGs in here.
maestro/flows/*.png

# Generated media fixtures — only the manifest is committed
fixtures/*
!fixtures/manifest.json

# Captured run output — frames, clips and raw audio pulled off the device
artifacts/

# Node
node_modules/

# macOS
.DS_Store
xcuserdata/
*.xcuserstate
