{
  "name": "teamstationMobile",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "teamstationMobile",
      "version": "1.0.0",
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/gsCameraman": {
      "name": "@gamestation/cameraman",
      "version": "1.0.0",
      "engines": {
        "node": ">=20"
      }
    },
    "apps/gsCameramanAndroid": {
      "name": "@gamestation/cameraman-android",
      "version": "1.0.0",
      "engines": {
        "node": ">=20"
      }
    },
    "apps/tsDirector": {
      "name": "@teamstation/director",
      "version": "1.0.0",
      "engines": {
        "node": ">=20"
      }
    },
    "apps/tsPreview": {
      "name": "@teamstation/preview",
      "version": "1.0.0",
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@gamestation/cameraman": {
      "resolved": "apps/gsCameraman",
      "link": true
    },
    "node_modules/@gamestation/cameraman-android": {
      "resolved": "apps/gsCameramanAndroid",
      "link": true
    },
    "node_modules/@teamstation/director": {
      "resolved": "apps/tsDirector",
      "link": true
    },
    "node_modules/@teamstation/preview": {
      "resolved": "apps/tsPreview",
      "link": true
    },
    "packages/watcherCore": {
      "version": "1.0.0",
      "extraneous": true,
      "peerDependencies": {
        "@react-native-async-storage/async-storage": "*",
        "react": "*",
        "react-native": "*"
      }
    },
    "packages/watcherCoreAndroid": {
      "version": "1.0.0",
      "extraneous": true
    }
  }
}
