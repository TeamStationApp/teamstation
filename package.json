{
  "name": "gamestation2",
  "version": "0.1.0",
  "private": true,
  "description": "GameStation 2.0 \u2014 video server and app, serving gamestation.co",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "audit-videos": "node -r sucrase/register src2/server/dev/auditVideos.ts",
    "backfill-linescore": "node -r sucrase/register src2/server/dev/backfillLinescore.ts",
    "build": "tsc -p tsconfig.server.json && mkdir -p lib/server/stats/fixtures && cp src2/server/stats/fixtures/*.json lib/server/stats/fixtures/",
    "build.field": "GS_FIELD_PREVIEW=1 node src2/build.mjs",
    "build.web": "node src2/build.mjs",
    "camera-sweep": "node -r sucrase/register src2/server/dev/cameraSweep.ts",
    "clean": "rimraf lib",
    "coverage": "npm run coverage.app && npm run coverage.server",
    "coverage.app": "node scripts/build-scoring-tests.mjs && node scripts/scoring-coverage.mjs",
    "coverage.server": "node src2/migrate/requirePostgres18.js && c8 --all --reporter=text --check-coverage --lines 90 --include src2/common/userIdNumber.ts --include src2/server/db/int8.ts --include src2/common/gumboEventTypes.ts --include src2/common/gumboPlay.ts --include src2/server/events/**/*.ts --include src2/server/routes/events.ts --include src2/server/routes/teams.ts --include src2/server/routes/logs.ts --include src2/server/teams/resolveOpponent.ts --include src2/server/teams/teamNames.ts --include src2/common/scheduleGames.ts --include 'src2/server/schedule/**/*.ts' --include src2/server/routes/schedule.ts --include src2/migrate/migrations/041scheduleApi.ts --include src2/server/jsonBody.ts mocha -r sucrase/register --extension ts --spec 'src2/**/*.test.ts' --ignore '**/node_modules/**' --ignore 'lib/**'",
    "demo": "node -r sucrase/register src2/server/dev/demo.ts",
    "duplicate-people": "node -r sucrase/register src2/server/dev/duplicatePeople.ts",
    "fake-space": "node -r sucrase/register src2/server/dev/fakeSpace.ts",
    "fix": "eslint . --fix",
    "import-archive": "node -r sucrase/register src2/server/dev/importArchiveCameras.ts",
    "import-invites": "node -r sucrase/register src2/server/dev/importInvites.ts",
    "import-video": "node -r sucrase/register src2/server/dev/importVideoFile.ts",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "make-season": "node -r sucrase/register src2/server/dev/makeSeasonFromVideos.ts",
    "merge-team": "node -r sucrase/register src2/server/dev/mergeTeam.ts",
    "metro": "react-native start",
    "migrate": "node -r sucrase/register src2/migrate/cli.ts",
    "migrate-peertube": "node -r sucrase/register src2/server/dev/migratePeertubeToSpaces.ts",
    "precommit": "npm run lint",
    "prepare": "husky",
    "preview.field": "GS_FIELD_PREVIEW=1 node src2/build.mjs --serve",
    "refold-scored-games": "node -r sucrase/register src2/server/dev/refoldScoredGames.ts",
    "repair-people": "node -r sucrase/register src2/server/dev/repairPeople.ts",
    "same-person": "node -r sucrase/register src2/server/dev/samePerson.ts",
    "sample-video": "node -r sucrase/register src2/server/dev/makeSampleVideo.ts",
    "scoring-game": "node -r sucrase/register src2/server/dev/scoringGame.ts",
    "seed": "node -r sucrase/register src2/server/dev/seed.ts",
    "start": "node -r sucrase/register src2/server/index.ts",
    "start.web": "node src2/build.mjs --serve",
    "stats-builder": "node -r sucrase/register src2/server/statsBuilder/main.ts",
    "stats-fixture": "node -r sucrase/register src2/server/dev/postStatsFixture.ts",
    "stats-request": "node -r sucrase/register src2/server/statsBuilder/cli.ts",
    "test": "node scripts/build-scoring-tests.mjs && node scripts/checkScoringLayering.mjs && mocha -r sucrase/register -r ./src2/test/scoringDomSetup.cjs --extension ts --spec 'src2/**/*.test.ts' --spec lib/scoring-tests.cjs --ignore '**/node_modules/**'",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "typecheck.native": "tsc -p tsconfig.native.json",
    "validate-gumbo": "node -r sucrase/register src2/server/dev/validateGumbo.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-picker/picker": "^2.11.4",
    "@react-three/fiber": "9.7.0",
    "bcryptjs": "^3.0.2",
    "cleaner-config": "^0.1.10",
    "cleaners": "^0.3.9",
    "express": "^5.1.0",
    "hls.js": "^1.7.3",
    "kysely": "^0.29.6",
    "node-media-server": "4.2.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "^0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-patina": "^0.2.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-svg": "^15.15.5",
    "react-native-video": "^6.19.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.2",
    "rfc4648": "^1.5.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@react-three/test-renderer": "9.1.0",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.183.1",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-config-standard-kit": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.1",
    "prettier": "^3.5.3",
    "puppeteer": "^25.11.0",
    "rimraf": "^6.0.1",
    "sucrase": "^3.35.0",
    "typescript": "^5.6.3"
  }
}
