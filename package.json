{
  "name": "monero-lws-balancer",
  "version": "1.0.0",
  "description": "Load balancing wrapper for Monero LWS",
  "keywords": [
    "Airbitz",
    "Monero",
    "LWS",
    "Edge"
  ],
  "homepage": "https://github.com/EdgeApp/monero-lws-balancer#readme",
  "bugs": {
    "url": "https://github.com/EdgeApp/monero-lws-balancer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EdgeApp/monero-lws-balancer.git"
  },
  "license": "MIT",
  "author": "Paul Puey <paul@edge.app>",
  "main": "lib/index.js",
  "scripts": {
    "build.web": "webpack --mode production",
    "build.server": "tsc -p tsconfig.server.json",
    "build": "yarn build.server",
    "clean": "rimraf lib dist",
    "configure": "configure src/server/serverConfig.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "fix": "eslint . --ext .ts,.tsx --fix",
    "precommit": "yarn lint && yarn build",
    "prepare": "husky install && npm-run-all clean -p build.*",
    "start": "node -r sucrase/register src/server/index.ts",
    "start.web": "webpack serve --mode development",
    "setup": "node -r sucrase/register src/server/dbInit.ts",
    "test": "mocha -r sucrase/register 'src/__tests__/**/*.ts'",
    "types": "yarn build"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint"
  },
  "dependencies": {
    "cleaners": "^0.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/chai": "^4.2.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mocha": "^5.2.7",
    "@types/nano": "^7.0.0",
    "@types/node": "^24.3.1",
    "@types/node-fetch": "^2.5.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/universal-analytics": "^0.4.3",
    "@typescript-eslint/eslint-plugin": "^4.8.2",
    "@typescript-eslint/parser": "^4.8.2",
    "chai": "^3.5.0",
    "cleaner-config": "^0.1.10",
    "copy-webpack-plugin": "^13.0.1",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "edge-server-tools": "0.2.22",
    "eslint": "^9.32.0",
    "eslint-config-standard-kit": "^1.0.0",
    "express": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^10.5.3",
    "mocha": "^6.2.2",
    "nano": "^10.1.0",
    "node-fetch": "^2.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^3.0.0",
    "style-loader": "^4.0.0",
    "sucrase": "^3.35.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "universal-analytics": "^0.4.17",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
