{
  "name": "gamestation2",
  "version": "0.1.0",
  "private": true,
  "description": "GameStation 2.0 \u2014 video server and app, serving gamestation.co",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "audit-videos": "node -r sucrase/register src2/server/dev/auditVideos.ts",
    "backfill-linescore": "node -r sucrase/register src2/server/dev/backfillLinescore.ts",
    "build": "tsc -p tsconfig.server.json",
    "build.web": "node src2/build.mjs",
    "camera-sweep": "node -r sucrase/register src2/server/dev/cameraSweep.ts",
    "clean": "rimraf lib",
    "demo": "node -r sucrase/register src2/server/dev/demo.ts",
    "duplicate-people": "node -r sucrase/register src2/server/dev/duplicatePeople.ts",
    "fake-space": "node -r sucrase/register src2/server/dev/fakeSpace.ts",
    "fix": "eslint . --fix",
    "import-archive": "node -r sucrase/register src2/server/dev/importArchiveCameras.ts",
    "import-invites": "node -r sucrase/register src2/server/dev/importInvites.ts",
    "import-video": "node -r sucrase/register src2/server/dev/importVideoFile.ts",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "merge-team": "node -r sucrase/register src2/server/dev/mergeTeam.ts",
    "metro": "react-native start",
    "migrate": "node -r sucrase/register src2/migrate/cli.ts",
    "migrate-peertube": "node -r sucrase/register src2/server/dev/migratePeertubeToSpaces.ts",
    "precommit": "npm run lint",
    "prepare": "husky",
    "repair-people": "node -r sucrase/register src2/server/dev/repairPeople.ts",
    "same-person": "node -r sucrase/register src2/server/dev/samePerson.ts",
    "sample-video": "node -r sucrase/register src2/server/dev/makeSampleVideo.ts",
    "seed": "node -r sucrase/register src2/server/dev/seed.ts",
    "start": "node -r sucrase/register src2/server/index.ts",
    "start.web": "node src2/build.mjs --serve",
    "test": "mocha -r sucrase/register --extension ts --spec 'src2/**/*.test.ts' --ignore '**/node_modules/**' --ignore 'lib/**'",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "typecheck.native": "tsc -p tsconfig.native.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "bcryptjs": "^3.0.2",
    "cleaner-config": "^0.1.10",
    "cleaners": "^0.3.9",
    "express": "^5.1.0",
    "hls.js": "^1.7.3",
    "kysely": "^0.29.6",
    "node-media-server": "4.2.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-patina": "^0.2.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-svg": "^15.15.5",
    "react-native-video": "^6.19.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-config-standard-kit": "^1.0.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "prettier": "^3.5.3",
    "puppeteer": "^25.11.0",
    "rimraf": "^6.0.1",
    "sucrase": "^3.35.0",
    "typescript": "^5.6.3"
  }
}
