{
  "name": "gamestation2",
  "version": "0.1.0",
  "private": true,
  "description": "GameStation 2.0 — video server and app, replacing PeerTube at tube.gamestation.co",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "build.web": "node build.mjs",
    "start.web": "node build.mjs --serve",
    "clean": "rimraf lib",
    "lint": "eslint .",
    "migrate": "node -r sucrase/register migrate/cli.ts",
    "demo": "node -r sucrase/register server/dev/demo.ts",
    "seed": "node -r sucrase/register server/dev/seed.ts",
    "start": "node -r sucrase/register server/index.ts",
    "test": "mocha -r sucrase/register --extension ts --spec '**/*.test.ts' --ignore 'node_modules/**' --ignore 'lib/**'",
    "typecheck": "tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cleaner-config": "^0.1.10",
    "cleaners": "^0.3.9",
    "express": "^5.1.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.1",
    "rimraf": "^6.0.1",
    "sucrase": "^3.35.0",
    "typescript": "^5.6.3"
  }
}
