{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The app is bundled by esbuild, so resolve the way a bundler does. This
    // is not a preference: react-native 0.87 declares its types *only* inside
    // its `exports` map, which Node10 resolution ignores, so every
    // `from 'react-native'` was an implicit any. It passed anyway on machines
    // that happened to have an older react-native in the repository root, and
    // failed on a fresh clone — src reaching outside itself again.
    "moduleResolution": "bundler",
    // The app runs in a browser, so it gets the DOM as well as the language
    // library. The server config deliberately does not.
    "lib": ["es2023", "dom", "dom.iterable"],
    // A suite names the file it means in full, where a bare `./PagedList`
    // would reach the bundled tests' stand-in for it. Nothing here is emitted.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/common/**/*.ts",
    // The test helpers built on the app, and the e2e test that drives a
    // browser page with the DOM's types. The rest of src/test is the
    // server's, in tsconfig.server.test.json.
    "src/test/fakeScoreboardSocket.ts",
    "src/test/PagedListStandIn.tsx",
    "src/test/responderDrag.ts",
    "src/test/scoringHelpers.ts",
    "src/test/scoreboardServer.e2e.ts"
  ]
}
