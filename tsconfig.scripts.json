{
  // The TypeScript scripts that are not part of any build: the wall-clock
  // stamper's command line, the end-to-end helpers that run in Node or in a
  // page, and the tests of the native dependency patches. Here so the linter's type-aware rules see them; they reach into
  // `src` for what they share with the server.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["es2023", "dom"]
  },
  "include": [
    "scripts/stampWallClockSei.ts",
    "scripts/chat-history-recovery-fixtures.ts",
    "scripts/chat-history-recovery-link.ts",
    "scripts/chat-history-recovery-native-scenes.ts",
    "scripts/chat-history-recovery-peer.ts",
    "scripts/chat-history-recovery-ui-scenes.ts",
    "scripts/chat-history-recovery-chat2.ts",
    "scripts/chat-history-recovery-relay.ts",
    "scripts/e2e/**/*.ts",
    "scripts/testModels.test.ts",
    "scripts/testTiers.test.ts",
    "scripts/testTools.test.ts",
    "scripts/patchVideoSeekable.test.ts",
    "scripts/patchVideoItemNotifications.test.ts",
    "tools/dbLoad/**/*.ts"
  ]
}
