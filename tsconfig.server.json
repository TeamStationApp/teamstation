{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "lib",
    "noEmit": false
  },
  "include": [
    "src/common/**/*.ts",
    "src/migrate/**/*.ts",
    "src/server/**/*.ts",
    "src/logServer/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.integration.ts",
    "**/*.e2e.ts",
    "lib",
    "node_modules",
    "src/common/chatCrypto/core.web.ts",
    "src/common/chatCrypto/core.native.ts",
    "src/common/chatCrypto/wasmCore.ts"
  ]
}
